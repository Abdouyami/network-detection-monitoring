<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.networkmonitor.controller.AlertController" spacing="20" styleClass="alert-container">
    <!-- Alert Management Header -->
    <Label text="Alert Management" styleClass="alert-title" />

    <!-- Search and Filter Section -->
    <HBox spacing="10" styleClass="search-container">
        <TextField fx:id="txtSearch" promptText="Search by Type or Severity" styleClass="search-field" />
        <Button text="Search" onAction="#handleSearch" styleClass="search-button" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="refresh-button" />
    </HBox>

    <!-- Alert Table -->
    <TableView fx:id="tblAlerts" styleClass="alert-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colType" text="Type" prefWidth="200" styleClass="column-header"/>
            <TableColumn fx:id="colSeverity" text="Severity" prefWidth="200" styleClass="column-header"/>
            <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="200" styleClass="column-header"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" styleClass="action-buttons">
        <Button text="Acknowledge" onAction="#handleAcknowledge" styleClass="action-button" />
        <Button text="View Details" onAction="#handleViewDetails" styleClass="action-button" />
    </HBox>
</VBox>