<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.networkmonitor.controller.DeviceController" spacing="20" styleClass="device-container">
    <!-- Device Management Header -->
    <Label text="Device Management" styleClass="device-title" />

    <!-- Search and Filter Section -->
    <HBox spacing="10" styleClass="search-container">
        <TextField fx:id="txtSearch" promptText="Search by IP or Hostname" styleClass="search-field" />
    </HBox>

    <!-- Device Table -->
    <TableView fx:id="tblDevices" styleClass="device-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIpAddress" text="IP Address" prefWidth="200" styleClass="column-header"/>
            <TableColumn fx:id="colMacAddress" text="MAC Address" prefWidth="200" styleClass="column-header"/>
            <TableColumn fx:id="colHostname" text="Hostname" prefWidth="200" styleClass="column-header"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="150" styleClass="column-header"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" styleClass="action-buttons">
        <Button text="Isolate Device" onAction="#handleIsolateDevice" styleClass="action-button" />
        <Button text="View Details" onAction="#handleViewDetails" styleClass="action-button" />
    </HBox>
</VBox>