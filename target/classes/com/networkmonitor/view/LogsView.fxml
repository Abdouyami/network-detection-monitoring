<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.networkmonitor.controller.LogsController"
      spacing="10" 
      >
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Page Title -->
    <Label text="System Logs" styleClass="page-title" />

    <!-- Filter Section -->
    <HBox spacing="10" styleClass="filter-section">
        <TextField fx:id="txtSearch" 
                  promptText="Search logs..." 
                  styleClass="search-field" 
                  HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="cmbFilter" 
                  promptText="Filter by type" 
                  styleClass="filter-combo" />
        <Button text="Apply Filter" 
                onAction="#applyFilter" 
                styleClass="filter-button" />
    </HBox>

    <!-- Logs Table -->
    <TableView fx:id="tblLogs" 
               styleClass="logs-table" 
               VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTimestamp" 
                        text="Timestamp" 
                        prefWidth="150" 
                        styleClass="column-header"/>
            <TableColumn fx:id="colType" 
                        text="Type" 
                        prefWidth="100" 
                        styleClass="column-header"/>
            <TableColumn fx:id="colMessage" 
                        text="Message" 
                        prefWidth="300" 
                        styleClass="column-header"/>
            <TableColumn fx:id="colUser" 
                        text="User" 
                        prefWidth="150" 
                        styleClass="column-header"/>
            <TableColumn fx:id="colSeverity" 
                        text="Severity" 
                        prefWidth="100" 
                        styleClass="column-header"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" styleClass="action-buttons">
        <Button text="Export Logs" 
                onAction="#exportLogs" 
                styleClass="action-button" />
        <Button text="Clear Logs" 
                onAction="#clearLogs" 
                styleClass="action-button" />
    </HBox>
</VBox>