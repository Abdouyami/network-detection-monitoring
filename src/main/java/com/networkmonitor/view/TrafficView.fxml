<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.networkmonitor.controller.TrafficController" spacing="20" styleClass="traffic-container">
    <!-- Traffic Management Header -->
    <Label text="Traffic Management" styleClass="traffic-title" />

    <!-- Search and Filter Section -->
    <HBox spacing="10" styleClass="search-container">
        <TextField fx:id="txtSearch" promptText="Search by Src/Des IP or Protocol or Port" styleClass="search-field" />
        <Button text="Search" onAction="#handleSearch" styleClass="search-button" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="refresh-button" />
    </HBox>

    <!-- Traffic Table -->
    <TableView fx:id="tblTraffic" styleClass="traffic-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSourceIp" text="Source IP" prefWidth="150" styleClass="column-header"/>
            <TableColumn fx:id="colDestinationIp" text="Destination IP" prefWidth="150" styleClass="column-header"/>
            <TableColumn fx:id="colProtocol" text="Protocol" prefWidth="100" styleClass="column-header"/>
            <TableColumn fx:id="colPort" text="Port" prefWidth="80" styleClass="column-header"/>
            <TableColumn fx:id="colBytesSent" text="Bytes Sent" prefWidth="100" styleClass="column-header"/>
            <TableColumn fx:id="colBytesReceived" text="Bytes Received" prefWidth="120" styleClass="column-header"/>
            <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="150" styleClass="column-header"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" styleClass="action-buttons">
        <Button text="Export Traffic" onAction="#handleExportTraffic" styleClass="action-button" />
        <Button text="View Details" onAction="#handleViewDetails" styleClass="action-button" />
    </HBox>
</VBox>