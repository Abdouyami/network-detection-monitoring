<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.networkmonitor.controller.DeviceController" spacing="20" styleClass="device-container">
    <!-- Device Management Header -->
    <Label text="Device Management" styleClass="device-title" />

    <!-- Search and Filter Section -->
    <HBox spacing="10" styleClass="search-container">
        <TextField fx:id="txtSearch" promptText="Search by IP or Hostname" styleClass="search-field" />
        <Button text="Search" onAction="#handleSearch" styleClass="search-button" />
        <Button text="Refresh" onAction="#handleRefresh" styleClass="refresh-button" />
    </HBox>

    <!-- Device Table -->
    <TableView fx:id="tblDevices" styleClass="device-table">
        <columns>
            <TableColumn text="IP Address" property="ipAddress" />
            <TableColumn text="MAC Address" property="macAddress" />
            <TableColumn text="Hostname" property="hostname" />
            <TableColumn text="Status" property="status" />
        </columns>
    </TableView>

    <!-- Action Buttons -->
    <HBox spacing="10" styleClass="action-buttons">
        <Button text="Isolate Device" onAction="#handleIsolateDevice" styleClass="action-button" />
        <Button text="View Details" onAction="#handleViewDetails" styleClass="action-button" />
    </HBox>
</VBox>