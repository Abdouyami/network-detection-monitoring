<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<SplitPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="com.networkmonitor.controller.NetworkMapController" 
    styleClass="network-map-container" dividerPositions="0.25">

    <!-- Left Sidebar -->
    <VBox fx:id="sidebar" styleClass="sidebar">
        <!-- Search Bar -->
        <HBox spacing="10" styleClass="search-container">
            <padding><Insets bottom="10"/></padding>
            <TextField fx:id="txtSearch" promptText="Search by IP or Hostname" 
                styleClass="search-field" HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#handleSearch" styleClass="search-button" />
        </HBox>

        <!-- Filters -->
        <VBox spacing="10" styleClass="filters-container">
            <Label text="Filters" styleClass="filters-title" />
            <CheckBox text="Active Devices" fx:id="chkActive" selected="true" 
                onAction="#handleFilter" styleClass="filter-checkbox"/>
            <CheckBox text="Suspicious Devices" fx:id="chkSuspicious" selected="true" 
                onAction="#handleFilter" styleClass="filter-checkbox"/>
            <CheckBox text="Inactive Devices" fx:id="chkInactive" selected="true" 
                onAction="#handleFilter" styleClass="filter-checkbox"/>
        </VBox>

        <!-- Actions -->
        <VBox spacing="10" styleClass="actions-container">
            <Label text="Actions" styleClass="actions-title" />
            <Button text="Refresh Map" onAction="#handleRefresh" styleClass="action-button" />
            <Button text="Export Map" onAction="#handleExport" styleClass="action-button" />
        </VBox>

        <!-- Legend -->
        <VBox spacing="10" styleClass="legend-container">
            <Label text="Legend" styleClass="legend-title" />

            <!-- Router Section -->
            <VBox spacing="5">
                <Label text="Router:" styleClass="device-type-label" />
                <GridPane hgap="10" vgap="5">
                    <padding>
                        <Insets left="25"/>
                    </padding>
                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <image>
                            <Image url="@/device-icons/router_active.png" />
                        </image>
                    </ImageView>
                    <Label text="Active" styleClass="legend-label, legend-label-active" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <image>
                            <Image url="@/device-icons/router_inactive.png" />
                        </image>
                    </ImageView>
                    <Label text="Inactive" styleClass="legend-label, legend-label-inactive" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <image>
                            <Image url="@/device-icons/router_suspicious.png" />
                        </image>
                    </ImageView>
                    <Label text="Suspicious" styleClass="legend-label, legend-label-suspicious" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>
            </VBox>

            <!-- PC Section -->
            <VBox spacing="5">
                <Label text="PC:" styleClass="device-type-label" />
                <GridPane hgap="10" vgap="5">
                    <padding>
                        <Insets left="25"/>
                    </padding>
                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <image>
                            <Image url="@/device-icons/pc_active.png" />
                        </image>
                    </ImageView>
                    <Label text="Active" styleClass="legend-label, legend-label-active" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <image>
                            <Image url="@/device-icons/pc_inactive.png" />
                        </image>
                    </ImageView>
                    <Label text="Inactive" styleClass="legend-label, legend-label-inactive" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <ImageView fitHeight="20" fitWidth="20" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <image>
                            <Image url="@/device-icons/pc_suspicious.png" />
                        </image>
                    </ImageView>
                    <Label text="Suspicious" styleClass="legend-label, legend-label-suspicious" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>
            </VBox>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" /> <!-- Spacer -->
    </VBox>

    <!-- Main Area -->
    <StackPane fx:id="mapContainer" styleClass="map-container">
        <ScrollPane fx:id="scrollPane" styleClass="map-scroll" 
            pannable="true" hbarPolicy="ALWAYS" vbarPolicy="ALWAYS">
            <Pane fx:id="mapCanvas" styleClass="map-canvas" />
        </ScrollPane>
    </StackPane>

</SplitPane>


